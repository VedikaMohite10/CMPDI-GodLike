# =============================================================================
# CMPDI AI Mining Intelligence Platform — Environment Config
# Copy this file to .env and adjust values as needed.
# .env is git-ignored; never commit secrets.
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=cmpdi
POSTGRES_PASSWORD=cmpdipass
POSTGRES_DB=cmpdi_mining
POSTGRES_PORT=5432

# ---------- Qdrant ----------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------- API ----------
API_PORT=8000

# ---------- Ollama (running on host, NOT inside Docker) ----------
# On Mac/Windows: host.docker.internal works out of the box
# On Linux:       use your host machine's LAN IP (e.g. 192.168.1.100)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- OCR Strategy ----------
# tesseract  — fast, CPU-friendly, suitable for clean scans (default)
# vlm        — qwen2.5vl:3b via Ollama, slower on CPU but better on messy docs
# hybrid     — Tesseract first; fall back to VLM if confidence < threshold
OCR_ENGINE=tesseract

# ---------- Upload Limits ----------
MAX_FILE_SIZE_MB=100
